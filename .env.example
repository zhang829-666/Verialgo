# 复制本文件为 .env，然后按需修改。已存在的 .env 不会被覆盖。
# 系统环境变量优先级高于本文件。

# ── 接口地址 ──
# 本地网关（来信 AI 工具箱统一版，端口以你机器上实际监听为准）
OPENAI_BASE_URL=http://127.0.0.1:3000/v1

# 其他常见选择：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1        # Ollama
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1         # vLLM / OneAPI

# ── 密钥 ──
# 本地网关通常不校验，随便填一个非空字符串也可以；DeepSeek 官方则填 sk- 开头的 key
OPENAI_API_KEY=sk-please-replace-me

# ── 模型名 ──
# DeepSeek: deepseek-chat / deepseek-reasoner；Ollama: qwen2.5-coder:14b 等
VERIALGO_MODEL=deepseek-chat

# ── 接口协议 ──
# auto = 先试 chat/completions，对方没启用该路由就自动切到 responses
# 也可以强制指定 chat 或 responses
VERIALGO_API_MODE=auto

# ── 运行参数（可选）──
VERIALGO_MAX_STEPS=20
VERIALGO_TIMEOUT=180
